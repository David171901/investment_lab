// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum InstrumentType {
  STOCK
  ETF
  CRYPTO
  CFD
  OTHER
}

enum OperationType {
  BUY
  SELL
  DIVIDEND
}

model Instrument {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  type      InstrumentType
  market    String?
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ticker con el que este instrumento se consulta en el proveedor de
  // cotizaciones (Fase 3.5). Si es null se deriva del `symbol` quitando el
  // sufijo de mercado de XTB (ej. `META.US` -> `META`). Existe para poder
  // corregir a mano los casos donde esa derivación no da el ticker real.
  externalTicker String?

  // Perfil de la empresa según el proveedor (Fase 3.6). Se cachean acá y no en
  // tabla aparte porque es 1:1 con el instrumento y casi nunca cambia: el
  // sector de una empresa no se mueve en años.
  //
  // `industry` es lo que devuelve el proveedor tal cual (granular, ~150
  // valores posibles); `sector` es el resultado de agruparlo con la tabla de
  // `sectors.ts`. Guardamos los dos para poder recategorizar sin volver a
  // pedirle nada al proveedor.
  industry String?
  sector   String?
  // País del emisor (ISO-2). No es el mercado donde cotiza: BAP y BVN cotizan
  // en NYSE pero son peruanas, y esa exposición no se ve en el sufijo de XTB.
  country  String?
  // Base del TTL. Se setea aunque el proveedor no devuelva nada, para no
  // reintentar en cada carga un ticker que no reconoce.
  profileFetchedAt DateTime?

  operations  Operation[]
  quote       Quote?
  candleCache CandleCache?
}

model Operation {
  id           String        @id @default(cuid())
  externalId   String        @unique
  type         OperationType
  date         DateTime
  quantity     Decimal
  price        Decimal
  commission   Decimal       @default(0)
  currency     String
  createdAt    DateTime      @default(now())

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
}

// Cache de la última cotización conocida de cada instrumento (Fase 3.5).
// No es un histórico: hay una fila por instrumento y se sobrescribe en cada
// consulta al proveedor. El histórico de velas no se persiste — se pide al
// proveedor bajo demanda.
model Quote {
  instrumentId String   @id
  price        Decimal
  currency     String
  // Momento al que corresponde el precio, según el proveedor.
  asOf         DateTime
  // Momento en que lo consultamos (base del TTL de cache).
  fetchedAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id])
}

// Cache de las velas históricas de un instrumento. Las velas diarias cambian
// una vez por día, así que un TTL largo evita gastar cuota del proveedor cada
// vez que se abre la vista de detalle.
model CandleCache {
  instrumentId String   @id
  payload      Json
  fetchedAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id])
}

enum ImportStatus {
  OK
  FAILED
}

// Bitácora de importaciones de archivos de XTB (Fase 4.5). No participa del
// modelo de dominio: no tiene relaciones y nada se deriva de ella. Existe para
// poder responder "¿cuándo actualicé por última vez?" y para dejar rastro de
// las importaciones que fallaron, que por definición no dejan ningún otro.
model ImportRun {
  id       String   @id @default(cuid())
  fileName String
  importedAt DateTime @default(now())
  // Conteo de operaciones antes y después del reemplazo. En una importación
  // fallida son iguales, porque la transacción revierte.
  operationsBefore Int
  operationsAfter  Int
  // Errores de parseo por fila (array de {sheet, row, message}).
  errors   Json
  status   ImportStatus
}
