# Usado al correr la API directamente en el host (fuera de docker-compose),
# contra el Postgres publicado por docker-compose en localhost:5432.
DATABASE_URL="postgresql://investment_lab:investment_lab@localhost:5432/investment_lab?schema=public"

# Puerto de la API al correr fuera de Docker (Next.js dev usa 3000 por defecto,
# así que la API local usa 3001 para no chocar, igual que el mapeo de docker-compose).
PORT=3001

# Origen permitido por CORS (el frontend corre en este puerto).
CORS_ORIGIN=http://localhost:3000
