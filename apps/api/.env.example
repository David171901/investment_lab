# Usado al correr la API directamente en el host (fuera de docker-compose),
# contra el Postgres publicado por docker-compose en localhost:5432.
DATABASE_URL="postgresql://investment_lab:investment_lab@localhost:5432/investment_lab?schema=public"

# Puerto de la API al correr fuera de Docker (Next.js dev usa 3000 por defecto,
# así que la API local usa 3001 para no chocar, igual que el mapeo de docker-compose).
PORT=3001

# Origen permitido por CORS (el frontend corre en este puerto).
CORS_ORIGIN=http://localhost:3000

# Fase 4 — API de Claude para el módulo `analysis`. Conseguí tu key en
# https://console.anthropic.com/ y pegala acá (nunca la subas al repo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fase 3.5 — Datos de mercado. Se usan DOS proveedores porque ninguno cubre bien
# ambas necesidades en su plan gratuito:
#
#  - PRECIOS -> Finnhub (https://finnhub.io/). Su límite es de 60 LLAMADAS/min,
#    así que cotizar todas las posiciones entra sin problema.
#  - VELAS   -> Twelve Data (https://twelvedata.com/). El free tier de Finnhub
#    ya no incluye velas históricas (/stock/candle responde 403).
#
# Por qué no Twelve Data también para precios: cobra 1 crédito POR SÍMBOLO con
# un techo de 8 créditos/min, así que un portafolio de 13 posiciones no entra
# nunca. Para velas sí alcanza, porque se pide de a un símbolo por vez.
#
# Cada key es opcional e independiente: sin Finnhub no hay valor de mercado
# (todo se muestra a costo); sin Twelve Data no hay gráfico de velas.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Solo para pruebas: apuntan los clientes a un mock local en vez de la API real,
# para medir consumo sin gastar cuota. Vacío = API real.
# FINNHUB_BASE_URL=http://localhost:4998
# TWELVEDATA_BASE_URL=http://localhost:4999
