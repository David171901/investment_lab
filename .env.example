# Postgres (usado por docker-compose para levantar la base de datos)
POSTGRES_USER=investment_lab
POSTGRES_PASSWORD=investment_lab
POSTGRES_DB=investment_lab
POSTGRES_PORT=5432

# API — DATABASE_URL usado dentro de docker-compose (host "db" = contenedor de Postgres)
DATABASE_URL=postgresql://investment_lab:investment_lab@db:5432/investment_lab?schema=public
API_PORT=3001

# Web
WEB_PORT=3000
